{
  "name": "sample",
  "prefix": "",
  "cors": true,
  "folders": [
    {
      "id": "users",
      "name": "Users",
      "parentId": null
    },
    {
      "id": "regex",
      "name": "Regex 경로",
      "parentId": null
    }
  ],
  "routes": [
    {
      "id": "list-users",
      "method": "GET",
      "path": "/users",
      "description": "사용자 목록",
      "folderId": "users",
      "responses": [
        {
          "id": "3a1e6c2e-0d6f-4a1b-9d7e-1b2c3d4e5f60",
          "label": "정상",
          "status": 200,
          "headers": {},
          "body": [
            {
              "id": 1,
              "name": "{{faker \"person.fullName\"}}",
              "email": "{{faker \"internet.email\"}}"
            },
            {
              "id": 2,
              "name": "{{faker \"person.fullName\"}}",
              "email": "{{faker \"internet.email\"}}"
            }
          ],
          "latencyMs": 0,
          "rules": []
        }
      ]
    },
    {
      "id": "get-user",
      "method": "GET",
      "path": "/users/:id",
      "description": "사용자 조회. id 가 0 이면 404",
      "folderId": "users",
      "responses": [
        {
          "id": "8f2b7d1c-5e4a-4c3b-8a9d-2c3d4e5f6071",
          "label": "없는 사용자",
          "status": 404,
          "headers": {},
          "body": {
            "error": "not found"
          },
          "latencyMs": 0,
          "rules": [
            {
              "target": "params",
              "key": "id",
              "equals": "0"
            }
          ]
        },
        {
          "id": "c4d5e6f7-1a2b-4c3d-9e8f-3d4e5f607182",
          "label": "정상",
          "status": 200,
          "headers": {},
          "body": {
            "id": "{{urlParam \"id\"}}",
            "name": "{{faker \"person.fullName\"}}",
            "email": "{{faker \"internet.email\"}}"
          },
          "latencyMs": 200,
          "rules": []
        }
      ]
    },
    {
      "id": "create-user",
      "method": "POST",
      "path": "/users",
      "description": "사용자 생성",
      "folderId": "users",
      "responses": [
        {
          "id": "d5e6f708-2b3c-4d4e-af90-4e5f60718293",
          "label": "",
          "status": 201,
          "headers": {},
          "body": {
            "id": "{{faker \"string.uuid\"}}"
          },
          "latencyMs": 0,
          "rules": []
        }
      ]
    },
    {
      "id": "regex-files",
      "method": "GET",
      "path": "/files/:name\\.(png|jpg|gif)",
      "description": "정규식 경로: 확장자가 png/jpg/gif 인 파일만. :name 은 params 로 들어온다",
      "folderId": "regex",
      "responses": [
        {
          "id": "e6f70819-3c4d-4e5f-b0a1-5f6071829304",
          "label": "정상",
          "status": 200,
          "headers": {},
          "body": {
            "file": "{{urlParam \"name\"}}",
            "url": "{{faker \"image.url\"}}"
          },
          "latencyMs": 0,
          "rules": []
        }
      ]
    },
    {
      "id": "regex-catch-all",
      "method": "GET",
      "path": "/legacy/v[0-9]+/*",
      "description": "정규식 경로: /legacy/v1/..., /legacy/v22/... 뭐든 받음 (* 는 .* 로 바뀜)",
      "folderId": "regex",
      "responses": [
        {
          "id": "f7081920-4d5e-4f60-a1b2-607182930415",
          "label": "폐기 안내",
          "status": 410,
          "headers": {},
          "body": {
            "error": "gone",
            "message": "legacy API 는 더 이상 지원하지 않습니다"
          },
          "latencyMs": 0,
          "rules": []
        }
      ]
    }
  ]
}
